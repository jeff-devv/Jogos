# Padrão de formatação do projeto (o VS Code aplica com a extensão "EditorConfig for VS Code").
# Regras completas de código em PADRAO.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,txt}]
end_of_line = crlf
